#!/bin/sh
# Pre-commit hook: bloquea archivos grandes, rutas prohibidas y secretos

ALLOWLIST=".git-large-files-allowlist"
PROHIBITED_PATTERNS="build/ \.dart_tool/ \.gradle/ node_modules/ \.tmp\.driveupload/ dist/ release/ releases/ \.pub/ \.cache/"
PROHIBITED_EXTENSIONS="\.apk$ \.aab$ \.msix$ \.zip$ \.7z$ \.rar$"
MAX_SIZE_MB=100
MAX_SIZE_BYTES=$((MAX_SIZE_MB * 1024 * 1024))
HAS_ERRORS=0

# Verificar archivos grandes
git diff --cached --name-only -z | xargs -0 ls -l 2>/dev/null | while read perms links user group size rest; do
  file=$(echo "$rest" | sed 's/.* //')
  if [ "$size" -gt "$MAX_SIZE_BYTES" ] 2>/dev/null; then
    if grep -qx "$file" "$ALLOWLIST" 2>/dev/null; then
      echo "  (permitido por allowlist) $file"
    else
      echo "ERROR: Archivo >${MAX_SIZE_MB}MB: $file (${size} bytes)"
      HAS_ERRORS=1
    fi
  fi
done

# Verificar patrones prohibidos
for pattern in $PROHIBITED_PATTERNS; do
  MATCHES=$(git diff --cached --name-only | grep -E "$pattern")
  if [ -n "$MATCHES" ]; then
    echo "ERROR: Ruta prohibida encontrada ($pattern):"
    echo "$MATCHES"
    HAS_ERRORS=1
  fi
done

# Verificar extensiones prohibidas
for ext in $PROHIBITED_EXTENSIONS; do
  MATCHES=$(git diff --cached --name-only | grep -E "$ext")
  if [ -n "$MATCHES" ]; then
    echo "ERROR: Extensión prohibida encontrada ($ext):"
    echo "$MATCHES"
    HAS_ERRORS=1
  fi
done

# Verificar secretos (patrones básicos)
git diff --cached -U0 | grep -E '^\+.*(password|secret|api_key|apiKey|PRIVATE KEY|BEGIN RSA)' | grep -v '^\+.*(placeholder|example|tu_key)' > /dev/null 2>&1
if [ $? -eq 0 ]; then
  echo "ERROR: Posible secreto detectado en el diff. Revisá antes de commitear."
  HAS_ERRORS=1
fi

if [ "$HAS_ERRORS" -ne 0 ]; then
  echo "Commit bloqueado por el hook pre-commit."
  exit 1
fi

exit 0
