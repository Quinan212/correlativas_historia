# Binance Futures Testnet API
# Obtenelas en: https://demo-fapi.binance.com/ o desde tu entorno Binance Futures Demo/Testnet
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_SECRET_KEY=tu_secret_key_aqui
BINANCE_TESTNET=true

# AI provider
# rules = no external API key required
# openai = requires OPENAI_API_KEY
# anthropic = requires ANTHROPIC_API_KEY
AI_PROVIDER=rules
# OPENAI_API_KEY=sk-tu_key_aqui
# ANTHROPIC_API_KEY=sk-ant-tu_key_aqui

# Trading config
SYMBOL=BTCUSDT
LEVERAGE=5
MAX_POSITION_PCT=90
MAX_DAILY_LOSS_PCT=8
MAX_RISK_PER_TRADE_PCT=1.5
MIN_RISK_REWARD_RATIO=2.0
AUTO_TAKE_PROFIT_PCT=25.0
AUTO_STOP_LOSS_PCT=8.0
ENTRY_ORDER_TYPE=maker
MAKER_ENTRY_OFFSET_PCT=0.0
MIN_NET_PROFIT_PCT=5.0

# Comisiones
# Binance Futures standard taker fee: 0.04%
# VIP 0 maker: 0.02%, taker: 0.04%
TAKER_FEE_PCT=0.04
MAKER_FEE_PCT=0.02
MIN_PROFIT_OVER_FEES_X=2.0

# Timeframe
TIMEFRAME=5m
LOOP_INTERVAL_SECONDS=3
RUN_MINUTES=1440

# Start safely
# Keep AI_PROVIDER=rules unless you explicitly want an external AI API.
